# Local educational credentials; PostgreSQL and Redis are internal to Compose.
COMPOSE_PROJECT_NAME=soa-flight-booking
BOOKING_PORT=8081
FLIGHT_PORT=50051
FLIGHT_API_KEY=local-demo-key
RPC_ATTEMPTS=3
RPC_BACKOFF=100ms
RPC_ATTEMPT_TIMEOUT=500ms
RPC_TIMEOUT=2s
CB_FAILURE_THRESHOLD=5
CB_WINDOW=60s
CB_OPEN_TIMEOUT=15s
HTTP_TIMEOUT=8s
OPERATION_TIMEOUT=10s
RECOVERY_INTERVAL=1s
# Optional: export DOCKER_CONTEXT=colima-distsys (or your existing context).
