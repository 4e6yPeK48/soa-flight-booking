{
  "openapi": "3.0.3",
  "info": {
    "title": "Flight Booking",
    "version": "1.0.0",
    "description": "Money is int64 RUB kopecks. Dates use UTC. Uncertain mutation outcome: retry with the same Idempotency-Key."
  },
  "paths": {
    "/flights": {
      "get": {
        "operationId": "SearchFlights",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Flight"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ]
      }
    },
    "/flights/{id}": {
      "get": {
        "operationId": "GetFlight",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Flight"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "x-go-type": "string"
            }
          }
        ]
      }
    },
    "/bookings": {
      "get": {
        "operationId": "ListBookings",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Booking"
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ]
      },
      "post": {
        "operationId": "CreateBooking",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid",
              "x-go-type": "string"
            },
            "description": "Optional. Reuse with identical payload after timeout; no header creates a new independent operation."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateBookingRequest"
              }
            }
          }
        }
      }
    },
    "/bookings/{id}": {
      "get": {
        "operationId": "GetBooking",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "x-go-type": "string"
            }
          }
        ]
      }
    },
    "/bookings/{id}/cancel": {
      "post": {
        "operationId": "CancelBooking",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "x-go-type": "string"
            }
          }
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Flight": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          },
          "airline": {
            "type": "string"
          },
          "flight_number": {
            "type": "string"
          },
          "origin": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "departure_time": {
            "type": "string",
            "format": "date-time"
          },
          "arrival_time": {
            "type": "string",
            "format": "date-time"
          },
          "total_seats": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "available_seats": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "price": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "RUB kopecks"
          },
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "DEPARTED",
              "CANCELLED",
              "COMPLETED"
            ]
          }
        },
        "required": [
          "id",
          "airline",
          "flight_number",
          "origin",
          "destination",
          "departure_time",
          "arrival_time",
          "total_seats",
          "available_seats",
          "price",
          "status"
        ]
      },
      "Booking": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          },
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "flight_id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          },
          "passenger_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "passenger_email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "seat_count": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "total_price": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "description": "RUB kopecks, frozen at booking creation"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user_id",
          "flight_id",
          "passenger_name",
          "passenger_email",
          "seat_count",
          "total_price",
          "status",
          "created_at"
        ]
      },
      "CreateBookingRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "user_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "flight_id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          },
          "passenger_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "passenger_email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "seat_count": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          }
        },
        "required": [
          "user_id",
          "flight_id",
          "passenger_name",
          "passenger_email",
          "seat_count"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          },
          "booking_id": {
            "type": "string",
            "format": "uuid",
            "x-go-type": "string"
          }
        },
        "required": [
          "error_code",
          "message"
        ]
      }
    }
  }
}
